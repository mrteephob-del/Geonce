# ==========================================
# GEONCE Official Store - Environment Template
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าใช้งานจริง
# ==========================================

# 1. LINE Developers LIFF ID (จาก https://developers.line.biz)
LIFF_ID=your_liff_id_here

# 2. Google Apps Script Web App URL (ลงท้ายด้วย /exec)
GAS_API_URL=https://script.google.com/macros/s/your_deployment_id/exec

# 3. ข้อมูลร้านค้าแบรนด์เสื้อผ้า GEONCE
SHOP_NAME=GEONCE
SHOP_TAGLINE=Official Streetwear & Contemporary Apparel
CURRENCY_SYMBOL=฿

# 4. การตั้งค่าบัญชีชำระเงิน PromptPay QR (เบอร์โทร 10 หลัก หรือเลขบัตร 13 หลัก)
PROMPTPAY_NUMBER=0812345678
PROMPTPAY_NAME=GEONCE OFFICIAL STORE
BANK_NAME=พร้อมเพย์ (PromptPay)

# 5. ตัวเลือกขนาดเสื้อผ้าเริ่มต้น (คั่นด้วยจุลภาค)
DEFAULT_SIZES=S,M,L,XL
